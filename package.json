{
  "name": "ncut",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "a flat, dark, in-browser video editor. multi-track timeline, real-time preview, local-only, no watermark.",
  "author": "sagecsharp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagecsharp/ncut.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "app:dev": "electron . --dev-url=http://localhost:5173",
    "icon": "node scripts/make-icon.cjs",
    "exe": "npm run build && npm run qos && electron-builder --win --x64",
    "qos": "node scripts/build-qos.cjs",
    "web": "tsc --noEmit && vite build --base=./ --outDir dist-web && node scripts/make-web-zip.cjs",
    "notices": "node scripts/make-notices.cjs"
  },
  "build": {
    "appId": "com.sagecsharp.ncut",
    "productName": "ncut",
    "copyright": "Copyright (c) 2026 sagecsharp",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "ncut",
        "name": "ncut project",
        "description": "ncut project",
        "role": "Editor"
      }
    ],
    "publish": null,
    "electronLanguages": [
      "en-US"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "ncut-${version}-portable.exe",
      "useZip": true
    },
    "nsis": {
      "artifactName": "ncut-${version}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      {
        "from": "build/bin",
        "to": ".",
        "filter": [
          "ncut-qos.exe"
        ]
      }
    ]
  },
  "dependencies": {
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/kode-mono": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/rubik-mono-one": "^5.3.0",
    "@fontsource/satisfy": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "lucide-react": "^1.70.0",
    "mediabunny": "^1.65.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
